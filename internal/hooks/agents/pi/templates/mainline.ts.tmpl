// {{ .ManagedMarker }}
// Generated by Mainline. Re-run "mainline hooks install --agent pi" to update.

import { spawn } from "node:child_process";
import type { ExtensionAPI } from "@earendil-works/pi-coding-agent";

const MAINLINE_COMMAND_MODE = {{ .CommandMode }};
const MAINLINE_COMMAND = {{ .Command }};
const MAINLINE_ARGS_PREFIX = {{ .ArgsPrefix }};
const HOOK_TIMEOUT_MS = 30000;

type HookOutput = {
	systemPromptAppend?: string;
	additionalContext?: string;
	context?: string;
};

function debug(message: string): void {
	if (process.env.MAINLINE_HOOKS_DEBUG) console.error("[mainline pi] " + message);
}

function sessionId(ctx: { sessionManager?: { getSessionFile?: () => string | undefined } }): string | undefined {
	try {
		return ctx.sessionManager?.getSessionFile?.();
	} catch {
		return undefined;
	}
}

function extractContext(out: HookOutput | undefined): string | undefined {
	return out?.systemPromptAppend ?? out?.additionalContext ?? out?.context;
}

async function runMainlineHook(
	hookName: string,
	payload: Record<string, unknown>,
	cwd: string,
): Promise<HookOutput | undefined> {
	return new Promise((resolve) => {
		const child = spawn(MAINLINE_COMMAND, [...MAINLINE_ARGS_PREFIX, hookName], {
			cwd,
			stdio: ["pipe", "pipe", "pipe"],
		});

		let stdout = "";
		let stderr = "";
		const timer = setTimeout(() => {
			debug("timed out running " + hookName);
			child.kill("SIGTERM");
			resolve(undefined);
		}, HOOK_TIMEOUT_MS);

		child.stdout.on("data", (chunk) => {
			stdout += String(chunk);
		});
		child.stderr.on("data", (chunk) => {
			stderr += String(chunk);
		});
		child.on("error", (err) => {
			clearTimeout(timer);
			debug("failed to run " + hookName + ": " + err.message);
			resolve(undefined);
		});
		child.on("close", () => {
			clearTimeout(timer);
			if (stderr.trim()) debug(stderr.trim());
			const text = stdout.trim();
			if (!text) {
				resolve(undefined);
				return;
			}
			try {
				resolve(JSON.parse(text) as HookOutput);
			} catch {
				debug("non-JSON hook output from " + hookName);
				resolve(undefined);
			}
		});
		child.stdin.on("error", (err) => {
			debug("stdin error for " + hookName + ": " + err.message);
		});

		try {
			child.stdin.end(JSON.stringify(payload));
		} catch (err) {
			debug("failed to write payload for " + hookName + ": " + String(err));
			resolve(undefined);
		}
	});
}

export default function mainlinePiExtension(pi: ExtensionAPI) {
	let pendingSessionContext: string | undefined;

	pi.on("session_start", async (event, ctx) => {
		const out = await runMainlineHook(
			"session-start",
			{
				event: "session_start",
				reason: event.reason,
				previous_session_file: event.previousSessionFile,
				session_id: sessionId(ctx),
				cwd: ctx.cwd,
			},
			ctx.cwd,
		);
		pendingSessionContext = extractContext(out);
	});

	pi.on("before_agent_start", async (event, ctx) => {
		const out = await runMainlineHook(
			"user-prompt-submit",
			{
				event: "before_agent_start",
				prompt: event.prompt,
				session_id: sessionId(ctx),
				cwd: ctx.cwd,
			},
			ctx.cwd,
		);
		const parts = [pendingSessionContext, extractContext(out)].filter(
			(part): part is string => typeof part === "string" && part.length > 0,
		);
		pendingSessionContext = undefined;
		if (parts.length === 0) return undefined;
		return { systemPrompt: event.systemPrompt + "\n\n" + parts.join("\n\n") };
	});

	pi.on("agent_end", async (event, ctx) => {
		await runMainlineHook(
			"stop",
			{
				event: "agent_end",
				status: "completed",
				message_count: Array.isArray(event.messages) ? event.messages.length : undefined,
				session_id: sessionId(ctx),
				cwd: ctx.cwd,
			},
			ctx.cwd,
		);
	});

	pi.on("session_before_compact", async (event, ctx) => {
		await runMainlineHook(
			"pre-compact",
			{
				event: "session_before_compact",
				custom_instructions: event.customInstructions,
				session_id: sessionId(ctx),
				cwd: ctx.cwd,
			},
			ctx.cwd,
		);
	});

	pi.on("session_shutdown", async (event, ctx) => {
		await runMainlineHook(
			"session-end",
			{
				event: "session_shutdown",
				reason: event.reason,
				target_session_file: event.targetSessionFile,
				session_id: sessionId(ctx),
				cwd: ctx.cwd,
			},
			ctx.cwd,
		);
	});
}
